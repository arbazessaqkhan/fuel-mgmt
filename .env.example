# Database (Neon PostgreSQL)
# Get this from your Neon Console -> Dashboard -> Connection String (Prisma format)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional: Neon direct connection (for prisma migrate if needed)
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Authentication (Vercel Production / Local)
# Choose your own username and password — they are read from process.env
AUTH_USERNAME="admin"
AUTH_PASSWORD="replace_with_a_secure_password"
# Generate a random 32+ character string (e.g., node -e "console.log(crypto.randomBytes(32).toString('hex'))")
AUTH_SECRET="replace_with_a_long_random_secret_at_least_32_characters"

# Image Storage (Backblaze B2 - S3 compatible, 10 GB free)
# Required on Vercel so voucher image uploads persist across serverless deployments
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_BUCKET="fuellog-images"
B2_KEY_ID="your_b2_key_id"
B2_APP_KEY="your_b2_app_key"

# AI OCR / Vision Model (OpenRouter or OpenAI)
OPENAI_API_KEY="your_api_key_here"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OCR_VISION_MODEL="z-ai/glm-4.6v"
OCR_VISION_FALLBACK_MODELS="google/gemini-2.0-flash-001,openai/gpt-4o-mini"

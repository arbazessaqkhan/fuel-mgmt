generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FuelVoucher {
  id        String   @id @default(uuid())
  voucherNo String   @unique @map("voucher_no")
  vehicleNo String   @map("vehicle_no")

  /// Indexed for fast per-vehicle querying
  @@index([vehicleNo])

  liters    Float
  /// Petrol or Diesel — whichever line is filled on the physical voucher
  fuelType  String   @default("Diesel") @map("fuel_type")
  date      DateTime
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fuel_vouchers")
}
